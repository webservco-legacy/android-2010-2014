<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="co.webserv.android.radu"
    android:versionCode="10"
    android:versionName="1.0" >

    <uses-sdk android:minSdkVersion="8" />
    
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <application android:icon="@drawable/ic_launcher"
        android:label="@string/app_name" >
         
         <activity android:name=".SplashActvity" android:label="@string/app_name"
			android:configChanges="keyboard|keyboardHidden|orientation|locale">
			<intent-filter>
				<action android:name="android.intent.action.MAIN" />
				<category android:name="android.intent.category.LAUNCHER" />
			</intent-filter>
		</activity>

		<activity android:name=".BrowserActivity" android:label="@string/app_name"
			android:configChanges="locale|orientation">
			<intent-filter>
				<action android:name="com.italiamultimedia.android.election.BrowserActivity" />
				<category android:name="android.intent.category.DEFAULT" />
			</intent-filter>
		</activity>
        
    </application>

</manifest>