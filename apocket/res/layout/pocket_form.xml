<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/aPocketTheme.Pattern" >

    <RelativeLayout style="@style/aPocketTheme.Pattern" >

        <TextView
            android:id="@+id/pocket_form_tt"
            style="@style/aPocketTheme.Title"
            android:text="@string/pocket_add" />

        <RelativeLayout
            android:id="@+id/pocket_form"
            style="@style/aPocketTheme.Pattern"
            android:layout_below="@+id/pocket_form_tt" >

            <EditText
                android:id="@+id/pocket_title"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:hint="@string/pocket_title_form"
                android:inputType="text" />

            <Spinner
                android:id="@+id/pocket_type"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pocket_title"
                android:entries="@array/pocket_types"
                android:prompt="@string/pocket_type_form" />

            <Spinner
                android:id="@+id/pocket_currency"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pocket_type"
                android:entries="@array/pocket_currencies"
                android:prompt="@string/pocket_currency_form" />

            <EditText
                android:id="@+id/pocket_description"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pocket_currency"
                android:hint="@string/pocket_description_form"
                android:inputType="textMultiLine"
                android:lines="3" />

            <Button
                android:id="@+id/pocket_button"
                android:layout_width="fill_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/pocket_description"
                android:text="@string/pocket_save_button" />

            <TextView
                android:id="@+id/pocket_error"
                style="@style/aPocketTheme.TextResult.Error"
                android:layout_below="@+id/pocket_button"
                android:text="@string/form_error" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/pocket_result"
            style="@style/aPocketTheme.Pattern.Hidden"
            android:layout_below="@+id/pocket_form_tt" >

            <TextView
                android:id="@+id/pocket_success"
                style="@style/aPocketTheme.TextResult.Success"
                android:layout_below="@+id/pocket_button"
                android:text="@string/form_success" />
        </RelativeLayout>
    </RelativeLayout>

</ScrollView> <!-- $Id$ -->