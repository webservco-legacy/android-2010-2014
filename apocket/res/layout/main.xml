<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/aPocketTheme.Pattern" >
    
    <TextView
        android:id="@+id/dev"
        style="@style/aPocketTheme.Dev"
        android:text="@string/dev"
         />

    <TextView
        android:id="@+id/title"
        style="@style/aPocketTheme.Title"
        android:text="@string/app_name" />

    <TextView
        android:id="@+id/content"
        style="@style/aPocketTheme.Text.Margin"
        android:layout_below="@+id/title"
        android:text="@string/app_name" />

    

</RelativeLayout> <!-- $Id$ -->
