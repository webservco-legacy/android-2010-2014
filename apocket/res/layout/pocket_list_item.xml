<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/aPocketTheme.ListItem" >

    <TextView
        android:id="@+id/type"
        style="@style/aPocketTheme.ListItemTitle"
        android:text="@string/pocket_type" />

    <TextView
        android:id="@+id/title"
        style="@style/aPocketTheme.ListItemTitle"
        android:layout_toRightOf="@+id/type"
        android:text="@string/pocket_title" />

    <TextView
        android:id="@+id/currency"
        style="@style/aPocketTheme.ListItemSubtitle"
        android:layout_below="@+id/type"
        android:text="@string/pocket_currency" />

    <TextView
        android:id="@+id/total"
        style="@style/aPocketTheme.ListItemSubtitle"
        android:layout_below="@+id/type"
        android:layout_toRightOf="@+id/currency"
        android:text="@string/pocket_total" />

</RelativeLayout> <!-- $Id$ -->