<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
	android:orientation="vertical" android:layout_width="fill_parent"
	android:layout_height="wrap_content" android:paddingBottom="8dp">
	<TextView android:id="@+id/type" android:layout_width="wrap_content"
		android:layout_height="wrap_content" android:textSize="20dp"
		android:text="@string/pocket_type" android:layout_marginLeft="5dp"
		android:layout_marginTop="4dp" android:textStyle="bold"
		android:textColor="@color/green2"></TextView>
	<TextView android:id="@+id/title" android:layout_toRightOf="@+id/type"
		android:layout_width="wrap_content" android:layout_height="wrap_content"
		android:textSize="20dp" android:text="@string/pocket_title"
		android:layout_marginTop="4dp" android:layout_marginLeft="5dp"
		android:textStyle="bold" android:textColor="@color/green2"></TextView>
	<TextView android:id="@+id/currency" android:layout_below="@+id/type"
		android:layout_width="wrap_content" android:layout_height="wrap_content"
		android:layout_marginLeft="5dp" android:textSize="16dp"
		android:text="@string/pocket_currency" android:textColor="@color/green2"></TextView>
	<TextView android:id="@+id/total" android:layout_below="@+id/type"
		android:layout_toRightOf="@+id/currency" android:layout_width="wrap_content"
		android:layout_height="wrap_content" android:layout_marginLeft="5dp"
		android:textSize="16dp" android:text="@string/pocket_total"
		android:textColor="@color/green2"></TextView>
</RelativeLayout>
