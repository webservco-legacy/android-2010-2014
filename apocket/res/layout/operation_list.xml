<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/aPocketTheme.Pattern" >

    <TextView
        android:id="@+id/operation_list_title"
        style="@style/aPocketTheme.Title"
        android:text="@string/operation_list" />

    <View
        android:id="@+id/force_divider"
        style="@style/aPocketTheme.ListDivider"
        android:layout_below="@+id/operation_list_title" />

    <TextView
        android:id="@+id/empty"
        style="@style/aPocketTheme.Text.Margin"
        android:layout_below="@+id/operation_list_title"
        android:text="@string/no_operations" />

    <ListView
        android:id="@android:id/list"
        android:layout_width="fill_parent"
        android:layout_height="fill_parent"
        android:layout_below="@+id/force_divider" />

</RelativeLayout> <!-- $Id$ -->