<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/aPocketTheme.Pattern" >

    <TextView
        android:id="@+id/title"
        style="@style/aPocketTheme.Title"
        android:text="@string/pocket_list" />

    <View
        android:id="@+id/force_divider"
        style="@style/aPocketTheme.ListDivider"
        android:layout_below="@+id/title" />

    <TextView
        android:id="@+id/empty"
        style="@style/aPocketTheme.Text.Margin"
        android:layout_below="@+id/title"
        android:text="@string/no_pockets" />

    <ListView
        android:id="@android:id/list"
        style="@style/aPocketTheme.List"
        android:layout_below="@+id/force_divider" />

</RelativeLayout> <!-- $Id$ -->
