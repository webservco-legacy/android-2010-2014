<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    style="@style/aPocketTheme.ListItem" >

    <TextView
        android:id="@+id/amount"
        style="@style/aPocketTheme.ListItemTitle"
        android:text="@string/operation_amount" />
    
    <TextView
        android:id="@+id/currency"
        style="@style/aPocketTheme.ListItemTitle"
        android:layout_toRightOf="@+id/amount"
        android:text="@string/operation_currency" />

    <TextView
        android:id="@+id/pocket"
        style="@style/aPocketTheme.ListItemTitle.Simple"
        android:layout_toRightOf="@+id/currency"
        android:text="@string/operation_pocket_form" />

    <TextView
        android:id="@+id/date"
        style="@style/aPocketTheme.ListItemSubtitle.Strong"
        android:layout_below="@+id/amount"
        android:text="@string/operation_date" />

    <TextView
        android:id="@+id/notes"
        style="@style/aPocketTheme.ListItemSubtitle"
        android:layout_below="@+id/amount"
        android:layout_toRightOf="@+id/date"
        android:text="@string/operation_notes" />

</RelativeLayout> <!-- $Id$ -->