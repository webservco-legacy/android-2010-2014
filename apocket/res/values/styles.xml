<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="aPocketTheme" parent="@android:style/Theme.Light">
        <item name="android:orientation">vertical</item>
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:background">@color/ws_dark</item>
        <item name="android:textColor">@color/ws_light</item>
        <item name="android:textColorLink">@color/green</item>
    </style>
    
    <style name="aPocketTheme.Pattern">
        <item name="android:background">@drawable/bg_repeat</item>
    </style>

    <style name="aPocketTheme.Pattern.Hidden">
        <item name="android:visibility">gone</item>
    </style>

    <style name="aPocketTheme.Title">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20dp</item>
        <item name="android:layout_alignParentTop">true</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:layout_marginBottom">10dp</item>
        <item name="android:textAppearance">?android:attr/textAppearanceMedium</item>
        <item name="android:background">@color/transparent</item>
    </style>
    
    <style name="aPocketTheme.Dev">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">50dp</item>
        <item name="android:layout_alignParentBottom">true</item>
        <item name="android:layout_alignParentRight">true</item>
	</style>

    <style name="aPocketTheme.Text">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">wrap_content</item>
		<item name="android:background">@color/transparent</item>
    </style>
    
	<style name="aPocketTheme.Text.Margin">
	    <item name="android:layout_marginTop">5dp</item>
	</style>

    <style name="aPocketTheme.TextResult">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textStyle">bold</item>
		<item name="android:background">@color/transparent</item>
    </style>

    <style name="aPocketTheme.TextResult.Error">
        <item name="android:textColor">@color/red</item>
    </style>

    <style name="aPocketTheme.TextResult.Success">
        <item name="android:textColor">@color/green</item>
    </style>

    <style name="aPocketTheme.List">
        <item name="android:layout_width">fill_parent</item>
        <item name="android:layout_height">fill_parent</item>
        <item name="android:headerDividersEnabled">true</item>
        <item name="android:footerDividersEnabled">true</item>
        <item name="android:divider">@color/ws_light</item>
        <item name="android:dividerHeight">2dp</item>
        <item name="android:cacheColorHint">@color/transparent</item>
    </style>

    <style name="aPocketTheme.ListDivider">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">2dp</item>
        <item name="android:background">@color/ws_light</item>
    </style>

    <style name="aPocketTheme.ListItem">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingBottom">8dp</item>
    </style>

    <style name="aPocketTheme.ListItemTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">20dp</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="aPocketTheme.ListItemSubtitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginLeft">5dp</item>
        <item name="android:textSize">16dp</item>
    </style>

</resources> <!-- $Id$ -->
