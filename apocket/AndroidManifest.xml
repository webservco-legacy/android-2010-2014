<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="co.webserv.android.apocket"
    android:versionCode="4"
    android:versionName="0.4" >

    <uses-sdk android:minSdkVersion="8" />

    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />

    <application
        android:icon="@drawable/icon"
        android:label="@string/app_name" >
        <activity android:name=".PocketListActivity" >
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".UserAddActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan" />
        <activity
            android:name=".UserActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan" />
        <activity android:name=".AboutActivity" />
        <activity android:name=".DatabaseImportActivity" />
        <activity android:name=".DatabaseBackupActivity" />
        <activity android:name=".DatabaseRestoreActivity" />
        <activity android:name=".DatabaseDeleteActivity" />
        <activity
            android:name=".PocketDetailsActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan" />
        <activity android:name=".OperationListActivity" />
        <activity
            android:name=".OperationDetailsActivity"
            android:windowSoftInputMode="stateAlwaysHidden|adjustPan" />
    </application>

</manifest> <!-- $Id$ -->
